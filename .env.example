# MongoDB connection string used by the API routes.
DATABASE_URL=mongodb://localhost:27017/productivity-tracker

# Public base URL for the Next.js app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 bucket holding the uploaded PDFs. Create the bucket under R2, then
# an R2 API token with Object Read & Write on it; the Account ID is on the same page.
# Server-only — never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=productivity-tracker

# Auth.js session signing key. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=...
